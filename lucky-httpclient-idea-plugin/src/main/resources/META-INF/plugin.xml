<idea-plugin>
    <id>com.luckyframework.httpclient.spel</id>
    <name>Lucky HttpClient SpEL</name>
    <vendor>luckyframework</vendor>
    <description><![CDATA[
        SpEL（Spring Expression Language）编辑支持：为 lucky-httpclient 的注解与配置提供
        语法高亮、上下文感知补全、符号跳转、悬停文档、静态检查与受控求值。
        仅在依赖 lucky-httpclient 的模块中生效，不影响其他项目。
    ]]></description>

    <depends>com.intellij.modules.java</depends>
    <!-- YAML 支持为可选能力：未安装 YAML 插件时不加载 yaml-spel-support.xml -->
    <depends optional="true" config-file="yaml-spel-support.xml">org.jetbrains.plugins.yaml</depends>

    <extensions defaultExtensionNs="com.intellij">
        <annotator language="JAVA"
                   implementationClass="com.luckyframework.idea.spel.highlight.SpelAnnotator"/>
        <colorSettingsPage implementation="com.luckyframework.idea.spel.highlight.SpelColorSettingsPage"/>
        <additionalTextAttributes scheme="Default" file="colorSettings/Default.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSettings/Darcula.xml"/>
        <completion.contributor language="JAVA"
                                implementationClass="com.luckyframework.idea.spel.completion.SpelCompletionContributor"/>
        <typedHandler implementation="com.luckyframework.idea.spel.completion.SpelAutoPopupHandler"/>
        <!-- 输入分隔/终结字符时关闭 SpEL 补全列表，避免平台把高亮候选当成补全结果插入 -->
        <lookup.charFilter implementation="com.luckyframework.idea.spel.completion.SpelCharFilter" order="first"/>
        <psi.referenceContributor language="JAVA"
                                  implementation="com.luckyframework.idea.spel.reference.SpelReferenceContributor"/>
        <referencesSearch implementation="com.luckyframework.idea.spel.reference.SpelReferenceSearcher"/>
        <!-- 平台对方法的 Find Usages 与 unused 判定走 MethodReferencesSearch，
             不会执行 referencesSearch 扩展点；缺此注册时已被 SpEL 引用的方法仍会灰化 -->
        <methodReferencesSearch implementation="com.luckyframework.idea.spel.reference.SpelMethodReferenceSearcher"/>
        <renamePsiElementProcessor implementation="com.luckyframework.idea.spel.refactoring.SpelRenameProcessor"/>
        <!-- 带 @FunctionAlias 的方法重命名：过滤掉文本是别名的 SpEL 引用 -->
        <renamePsiElementProcessor order="first"
                                   implementation="com.luckyframework.idea.spel.refactoring.SpelMethodRenameProcessor"/>
        <!-- @FunctionAlias/@SpELImport 字符串内的名字：显式声明 Rename 动作可用 -->
        <renameHandler implementation="com.luckyframework.idea.spel.refactoring.SpelAliasRenameHandler"/>
        <lang.documentationProvider language="JAVA"
                                   implementationClass="com.luckyframework.idea.spel.documentation.SpelDocumentationProvider"/>
        <applicationConfigurable parentId="tools"
                                 id="lucky.httpclient.spel.settings"
                                 displayName="Lucky HttpClient SpEL"
                                 instance="com.luckyframework.idea.spel.settings.LuckyHttpClientConfigurable"/>
        <postStartupActivity implementation="com.luckyframework.idea.spel.activation.LuckyHttpClientProjectActivity"/>
        <!-- @LuckyComponent 组件类在导航、结构视图、查找类等位置显示四叶草类图标 -->
        <iconProvider implementation="com.luckyframework.idea.spel.component.LuckyComponentIconProvider"/>
        <localInspection shortName="UnresolvedSpelSymbol"
                         displayName="未解析的 SpEL 符号"
                         groupName="Lucky HttpClient SpEL"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.luckyframework.idea.spel.inspection.UnresolvedSpelSymbolInspection"/>
        <localInspection shortName="SpelFunctionCall"
                         displayName="SpEL 函数调用参数"
                         groupName="Lucky HttpClient SpEL"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="com.luckyframework.idea.spel.inspection.SpelFunctionCallInspection"/>
        <localInspection shortName="SpelMemberAccess"
                         displayName="SpEL 成员访问"
                         groupName="Lucky HttpClient SpEL"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="com.luckyframework.idea.spel.inspection.SpelMemberAccessInspection"/>
        <localInspection shortName="SpelSelectionCondition"
                         displayName="SpEL 条件表达式类型"
                         groupName="Lucky HttpClient SpEL"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="com.luckyframework.idea.spel.inspection.SpelSelectionConditionInspection"/>
        <localInspection shortName="SpelUnresolvedType"
                         displayName="未解析的 SpEL 类型"
                         groupName="Lucky HttpClient SpEL"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="com.luckyframework.idea.spel.inspection.SpelUnresolvedTypeInspection"/>
        <localInspection shortName="SpelImportFormat"
                         displayName="SpEL 导入声明格式"
                         groupName="Lucky HttpClient SpEL"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="com.luckyframework.idea.spel.inspection.SpelImportFormatInspection"/>
        <localInspection shortName="SpelLifecycleMisuse"
                         displayName="SpEL 生命周期误用"
                         groupName="Lucky HttpClient SpEL"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.luckyframework.idea.spel.inspection.SpelLifecycleMisuseInspection"/>
        <intentionAction>
            <className>com.luckyframework.idea.spel.intention.SpelWrapIntention</className>
        </intentionAction>
        <intentionAction>
            <className>com.luckyframework.idea.spel.intention.SpelUnwrapIntention</className>
        </intentionAction>
        <intentionAction>
            <className>com.luckyframework.idea.spel.intention.SpelExtractVariableIntention</className>
        </intentionAction>
        <intentionAction>
            <className>com.luckyframework.idea.spel.intention.SpelEvaluateIntention</className>
        </intentionAction>
    </extensions>

    <!-- 2026.3 起悬停/Quick Doc 优先走文档目标体系，虚拟声明需要主动提供目标 -->
    <extensions defaultExtensionNs="com.intellij.platform.backend">
        <documentation.targetProvider
                implementation="com.luckyframework.idea.spel.documentation.SpelDocumentationTargetProvider"/>
        <!-- 补全列表选中项的文档预览：由 lookup element 携带的虚拟声明产出目标 -->
        <documentation.psiTargetProvider
                implementation="com.luckyframework.idea.spel.documentation.SpelPsiDocumentationTargetProvider"/>
    </extensions>
</idea-plugin>
